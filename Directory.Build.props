<Project>
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />
  <PropertyGroup>
    <MelvorGameDir Condition="'$(MelvorGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Melvor Idle 2</MelvorGameDir>
    <GameData>$(MelvorGameDir)\data_GamesByMalcs.Melvor2_windows_x86_64</GameData>
    <LoaderDir>$(MelvorGameDir)\data_MelvorModLoader_windows_x86_64</LoaderDir>
  </PropertyGroup>
</Project>
